# capacitor-levelplay-ads declares a peer dependency on @capacitor/core >=8.0.0,
# but Capacitor 8 defaults iOS to Swift Package Manager, which this plugin's
# native SDK dependency doesn't support (CocoaPods is its only supported iOS
# path — see node_modules/capacitor-levelplay-ads/Package.swift). We stay on
# Capacitor 7 (CocoaPods-based) on purpose; the plugin's JS bridge is a plain
# registerPlugin() call with no v8-specific API, so it works fine on core 7.
legacy-peer-deps=true
